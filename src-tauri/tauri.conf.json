{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AION 2 Companion",
  "version": "../package.json",
  "identifier": "it.hobby.aion2companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AION 2 Companion",
        "width": 900,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDQjdBMjM0MzNEQjMzNEYKUldSUE05c3pOS0szREVaWnRvS29Jb2lmM1ZNN1djSjB3VEJEVFJxNHZ2UlVvVGdLY0F1cDFUN1cK",
      "endpoints": [
        "https://github.com/krajetum/AION2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
