{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "store:default",
    "autostart:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.steampowered.com/ISteamNews/*" }]
    }
  ]
}
