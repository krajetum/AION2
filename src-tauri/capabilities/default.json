{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window and the DPS overlay",
  "windows": [
    "main",
    "overlay",
    "events"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "store:default",
    "autostart:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.steampowered.com/ISteamNews/*"
        }
      ]
    }
  ]
}
